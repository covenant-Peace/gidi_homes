rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Listing photos: anyone can view; only signed-in users can upload,
    // under a path namespaced by their uid: property_images/{uid}/{file}.
    match /property_images/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
