rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public can read listings; only the owning agent can write their own.
    match /properties/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.agentId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.agentId == request.auth.uid;
    }

    // User profiles: public read (agents are shown on listings),
    // a user may only write their own document.
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
