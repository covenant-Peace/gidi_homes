rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Moderators — keep in sync with AppConfig.adminEmails.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email in ['covenantp4@gmail.com'];
    }

    // Listings: public read; the owning agent (or an admin, for moderation)
    // may write.
    match /properties/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.agentId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && (resource.data.agentId == request.auth.uid
                                || isAdmin());
    }

    // User profiles: public read; a user writes their own doc, an admin may
    // write any (to flip the verified flag).
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == uid || isAdmin());
    }

    // Chats: only the two participants can read/write the thread + messages.
    match /chats/{chatId} {
      // resource == null lets a participant check a not-yet-created thread
      // (getOrCreate) without leaking any data.
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
             get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Inspection requests: visible to and editable by the buyer and the agent.
    match /inspections/{id} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.buyerId
                      || request.auth.uid == resource.data.agentId);
      allow create: if request.auth != null
                    && request.resource.data.buyerId == request.auth.uid;
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.buyerId
                        || request.auth.uid == resource.data.agentId);
    }

    // Agent verification: the agent (doc id == their uid) or an admin.
    match /verifications/{agentId} {
      allow read: if request.auth != null
                  && (request.auth.uid == agentId || isAdmin());
      allow create, update: if request.auth != null
                  && (request.auth.uid == agentId || isAdmin());
    }
  }
}
